# =============================================================================
# Robot CI — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# =============================================================================

# ---- Devin API -------------------------------------------------------------
# Personal API key from https://app.devin.ai/settings/api-keys
# The orchestrator uses this to create and message every agent session.
DEVIN_API_KEY=

# Base URL for the Devin REST API. Override only for staging/self-hosted.
DEVIN_API_BASE=https://api.devin.ai/v1

# ---- GitHub ----------------------------------------------------------------
# Fine-grained PAT with `contents:write` and `pull_requests:write` on the
# TARGET_REPO. Used by `gh` for cloning and by github.py for branches/PRs.
GITHUB_TOKEN=

# The CUSTOMER repo under test — the robot control code we are CI for.
# Format: owner/name
TARGET_REPO=your-org/robot-arm-control

# Branch of TARGET_REPO that pushes are watched on.
TARGET_BRANCH=main

# Shared secret configured on the GitHub webhook; verifies X-Hub-Signature-256.
WEBHOOK_SECRET=change-me-to-a-random-string

# ---- Storage ---------------------------------------------------------------
# SQLite by default; any SQLAlchemy URL works.
DATABASE_URL=sqlite:///./robotci.db

# Where videos, reports, diffs and transcripts are written. Served by
# apps/api/app/routers/artifacts.py and referenced by run events.
ARTIFACTS_DIR=./artifacts

# Local checkout of MuJoCo Menagerie (populated by scripts/fetch_menagerie.sh).
MENAGERIE_DIR=./vendor/menagerie

# ---- Server ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Origin allowed through CORS and for the dashboard WebSocket.
UI_ORIGIN=http://localhost:3000

# ---- Pipeline tuning -------------------------------------------------------
# Number of randomized scenarios generated per suite run (the NxM matrix).
SUITE_SIZE=24

# Max Devin sessions alive at once across the whole run (fan-out ceiling).
MAX_PARALLEL_AGENTS=6

# Max fix/verify iterations a single agent may take before it is failed out.
MAX_AGENT_ITERATIONS=3
